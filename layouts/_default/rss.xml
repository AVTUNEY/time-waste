{{- $pages := .RegularPages -}}
{{- if eq .Kind "home" -}}
  {{- $pages = where .Site.RegularPages "Section" "posts" -}}
{{- end -}}
{{- $pages = sort $pages "Date" "desc" -}}
{{- $limit := 0 -}}
{{- with .Site.Config.Services.RSS -}}
  {{- $limit = .Limit -}}
{{- end -}}
{{- if gt $limit 0 -}}
  {{- $pages = first $limit $pages -}}
{{- end -}}

{{- $channelTitle := .Site.Title -}}
{{- if not .IsHome -}}
  {{- $channelTitle = printf "%s on %s" .Title .Site.Title -}}
{{- end -}}

{{- $channelDescription := .Description -}}
{{- if not $channelDescription -}}
  {{- if .IsHome -}}
    {{- $channelDescription = .Site.Params.Description | default (printf "Recent content on %s" .Site.Title) -}}
  {{- else -}}
    {{- $channelDescription = printf "Recent content in %s on %s" .Title .Site.Title -}}
  {{- end -}}
{{- end -}}

{{- $lastBuild := now -}}
{{- with index $pages 0 -}}
  {{- $lastBuild = .Lastmod -}}
{{- end -}}

{{- $baseURL := strings.TrimSuffix "/" .Site.BaseURL -}}

{{- with .OutputFormats.Get "RSS" -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ $channelTitle }}</title>
    <link>{{ $.Permalink }}</link>
    <description>{{ $channelDescription }}</description>
    <generator>Hugo</generator>
    {{- with $.Site.LanguageCode -}}
    <language>{{ . }}</language>
    {{- end -}}
    <lastBuildDate>{{ $lastBuild.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    <atom:link href="{{ .Permalink }}" rel="self" type="{{ .MediaType.Type }}" />
    {{- range $pages -}}
    {{- $itemTitle := .Title -}}
    {{- $itemTitle = replace $itemTitle "&" "&#x26;" -}}
    {{- $itemTitle = replace $itemTitle "<" "&#x3C;" -}}
    {{- $itemTitle = replace $itemTitle ">" "&#x3E;" -}}

    {{- $itemDescription := .Description -}}
    {{- if not $itemDescription -}}
      {{- $itemDescription = .Summary | plainify -}}
    {{- end -}}
    {{- $itemDescription = $itemDescription | truncate 200 -}}
    {{- $itemDescription = replace $itemDescription "]]>" "]]&gt;" -}}
    {{- $content := .Content -}}
    {{- $content = replaceRE " (style)=\"[^\"]*\"" "" $content -}}
    {{- $content = replaceRE " (style)='[^']*'" "" $content -}}
    {{- $content = replaceRE "(href|src)=\"/" (printf "$1=\"%s/" $baseURL) $content -}}
    <item>
      <title>{{ $itemTitle | safeHTML }}</title>
      <link>{{ .Permalink }}</link>
      <guid>{{ .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <description>{{ printf "<![CDATA[%s]]>" $itemDescription | safeHTML }}</description>
      <content:encoded>{{ printf "<![CDATA[%s]]>" $content | safeHTML }}</content:encoded>
    </item>
    {{- end -}}
  </channel>
</rss>
{{- end -}}
